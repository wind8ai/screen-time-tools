<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" MinHeight="520" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Title="Screen Time">
    <Window.Resources>
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="#F6F8FC"/>
            <Setter Property="BorderBrush" Value="#E5EAF3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="12" CornerRadius="18" Background="White" BorderBrush="#E5EAF3" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#1D2A45" BlurRadius="20" ShadowDepth="3" Opacity="0.13"/>
        </Border.Effect>
        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Name="TitleBar" Background="Transparent" Margin="0,0,0,22">
                <TextBlock Name="AppLabel" Margin="0,0,140,0" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                <ComboBox Name="LanguagePicker" Width="98" Height="28" HorizontalAlignment="Right"
                          Margin="0,0,40,0" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12">
                    <ComboBoxItem Content="中文" Tag="zh-CN"/>
                    <ComboBoxItem Content="English" Tag="en-US"/>
                </ComboBox>
                <Button Name="CloseButton" Content="&#x00D7;" Width="28" Height="28"
                        HorizontalAlignment="Right" FontSize="19"
                        Style="{StaticResource SoftButton}"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <TextBlock Name="HeadingText" FontSize="23" FontWeight="SemiBold" Foreground="#172033"/>
                <TextBlock Name="SubtitleText" TextWrapping="Wrap" FontSize="12" Foreground="#6B7280" Margin="0,8,0,0"/>
            </StackPanel>
            <UniformGrid Grid.Row="2" Rows="2" Columns="4" Margin="-3,-4,-3,14">
                <Button Name="Preset10" Tag="10" Margin="3,4" Style="{StaticResource SoftButton}"/>
                <Button Name="Preset15" Tag="15" Margin="3,4" Style="{StaticResource SoftButton}"/>
                <Button Name="Preset20" Tag="20" Margin="3,4" Style="{StaticResource SoftButton}"/>
                <Button Name="Preset25" Tag="25" Margin="3,4" Style="{StaticResource SoftButton}"/>
                <Button Name="Preset30" Tag="30" Margin="3,4" Style="{StaticResource SoftButton}"/>
                <Button Name="Preset45" Tag="45" Margin="3,4" Style="{StaticResource SoftButton}"/>
                <Button Name="Preset60" Tag="60" Margin="3,4" Style="{StaticResource SoftButton}"/>
                <Button Name="Preset90" Tag="90" Margin="3,4" Style="{StaticResource SoftButton}"/>
            </UniformGrid>
            <StackPanel Grid.Row="3">
                <TextBlock Name="CustomDurationLabel" FontSize="12" Foreground="#6B7280" Margin="0,0,0,8"/>
                <Border Name="MinutesBorder" CornerRadius="10" Background="#F8FAFD"
                        BorderBrush="#E5EAF3" BorderThickness="1" Height="58">
                    <Grid Margin="16,0">
                        <TextBox Name="MinutesInput" Text="60" MaxLength="10" FontSize="25"
                                 FontFamily="Segoe UI" Foreground="#172033" Background="Transparent"
                                 BorderThickness="0" Margin="0,0,42,0" VerticalContentAlignment="Center"
                                 AcceptsReturn="False"/>
                        <TextBlock Name="MinutesUnitLabel" FontSize="12" Foreground="#6B7280"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Name="ValidationText" Height="25" Padding="0,5,0,0" FontSize="11" Foreground="#DC5656"/>
            </StackPanel>
            <Border Name="EstimatePanel" Grid.Row="4" CornerRadius="10" Padding="14,11" Background="#EEF2FF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="EstimateLabel" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <TextBlock Name="EstimateText" Grid.Column="1" FontSize="15" FontWeight="SemiBold"
                               Foreground="#4F6BF0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <TextBlock Name="HintText" Grid.Row="5" Margin="0,14,0,0" FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
            <Grid Grid.Row="7" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Name="CancelButton" IsCancel="True" Style="{StaticResource SoftButton}"/>
                <Button Name="StartButton" Grid.Column="2" IsDefault="True"
                        FontWeight="SemiBold" Style="{StaticResource SoftButton}" Background="#4F6BF0" Foreground="White"/>
            </Grid>
        </Grid>
    </Border>
</Window>
